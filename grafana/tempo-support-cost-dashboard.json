      "title": "Monthly hours and billable hours",
      "datasource": "Tempo PostgreSQL",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"format": "time_series", "rawSql": "SELECT $__timeGroupAlias(worklog_date, '1M'), SUM(hours) AS hours, SUM(billable_hours) AS billable_hours FROM grafana_cost_by_jira_ticket WHERE $__timeFilter(worklog_date) GROUP BY 1 ORDER BY 1;", "refId": "A"}],
