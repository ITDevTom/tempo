    },
    {
      "id": 7,
      "type": "table",
      "title": "Top organisations by support cost",
      "datasource": "Tempo PostgreSQL",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 12},
      "targets": [{"format": "table", "rawSql": "SELECT organisation, ROUND(SUM(salary_cost)::numeric, 2) AS cost_gbp, ROUND(SUM(hours)::numeric, 2) AS hours, COUNT(DISTINCT jira_ticket) AS tickets FROM grafana_cost_by_jira_ticket WHERE organisation <> 'Unassigned' AND $__timeFilter(worklog_date) GROUP BY organisation ORDER BY SUM(salary_cost) DESC LIMIT 20;", "refId": "A"}],
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "displayMode": "auto"}}, "overrides": []},
      "options": {"showHeader": true, "footer": {"show": true, "reducer": ["sum"]}}
