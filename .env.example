TEMPO_TOKEN=replace-with-personal-tempo-token
TEMPO_BASE_URL=https://api.tempo.io
TEMPO_TEAM_ID=replace-with-tempo-support-team-id
DATABASE_URL=postgresql://tempo:tempo@postgres:5432/tempo
POSTGRES_PASSWORD=change-this-owner-password
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change-this-grafana-password
INITIAL_FROM=2000-01-01
INITIAL_TO=
SYNC_INTERVAL_SECONDS=3600
SYNC_OVERLAP_SECONDS=300
REDACT_DESCRIPTIONS=true
LOG_LEVEL=INFO
JIRA_DOMAIN=sortedgroup.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
# Empty = all Jira projects; set CS to mirror legacy JSM.py scope.
JIRA_JQL_PROJECT=
JIRA_ORGANISATION_FIELD=customfield_10002
JIRA_CUSTOMER_FIELD=customfield_10070
JIRA_CAB_ORGANISATION=Sorted Group
JIRA_LEAVE_ISSUES=CS-259
JIRA_INTERNAL_ISSUES=CS-35
JIRA_TRAINING_ISSUES=CS-670
